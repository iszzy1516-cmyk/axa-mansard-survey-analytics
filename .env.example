# Read-only connection to the IVR database (survey call data)
IVR_DATABASE_URL=mysql+pymysql://ivr_reader:password@ivr-host:3306/ivr_db

# Writable connection to the platform database (users, report_runs)
PLATFORM_DATABASE_URL=mysql+pymysql://platform:password@localhost:3306/platform_db

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
